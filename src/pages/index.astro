---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Button } from "@/components/ui/button";
import { BackgroundEffect } from "@/components/BackgroundEffect";
import { InteractivePreview } from "@/components/InteractivePreview";
import { motion } from "framer-motion";
---

<BaseLayout
  title="CuricuLab - AI CV Builder Gratis | Buat CV ATS-Friendly Tanpa Login"
  description="Pembuat CV AI Tercanggih 2026. Buat CV profesional & ATS-friendly secara gratis dengan Gemini AI. 100% aman, tanpa login, data tersimpan di browser Anda."
>
  <BackgroundEffect client:load />

  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-background">
    <!-- Decorative Elements (Neobrutalism Style) -->
    <div
      class="absolute top-10 right-10 -rotate-12 border-4 border-black bg-yellow-400 p-4 font-mono font-bold shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] hidden lg:block"
    >
      100% GRATIS!
    </div>
    <div
      class="absolute bottom-20 left-10 rotate-6 border-4 border-black bg-blue-400 p-3 font-mono font-bold shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] hidden lg:block"
    >
      NO LOGIN REQUIRED
    </div>

    <div class="container py-24 md:py-32">
      <div class="mx-auto max-w-4xl">
        <div class="grid gap-12 lg:grid-cols-[1fr_400px]">
          <div
            class="text-left animate-in fade-in slide-in-from-left duration-1000"
          >
            <!-- Badge -->
            <div
              class="mb-8 inline-flex items-center gap-2 border-4 border-black bg-green-400 px-6 py-2 font-mono text-sm font-bold shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
            >
              <span class="relative flex h-3 w-3">
                <span
                  class="absolute inline-flex h-full w-full animate-ping rounded-full bg-black opacity-20"
                ></span>
                <span class="relative inline-flex h-3 w-3 rounded-full bg-black"
                ></span>
              </span>
              CURICULAB v1.0
            </div>

            <!-- Headline -->
            <h1
              class="text-5xl font-black tracking-tighter md:text-7xl lg:text-8xl"
            >
              BUAT CV <br />
              <span
                class="bg-orange-500 px-4 py-2 text-white border-4 border-black shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] inline-block my-2"
              >
                SUPER ATS
              </span>
              <br />
              DENGAN AI.
            </h1>

            <!-- Subheadline -->
            <p
              class="mt-8 text-xl font-medium leading-relaxed md:text-2xl max-w-2xl border-l-8 border-black dark:border-white pl-6"
            >
              Hentikan penolakan kerja karena CV tidak terbaca sistem.
              <strong>CuricuLab</strong> menggunakan AI Gemini untuk memastikan CV
              Anda lolos ATS & memikat rekruter.
            </p>

            <!-- CTA Buttons -->
            <div class="mt-12 flex flex-col gap-6 sm:flex-row">
              <a href="/builder">
                <Button
                  size="lg"
                  className="h-16 border-4 border-black px-10 text-xl font-black shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] transition-all bg-primary text-white"
                >
                  MULAI SEKARANG →
                </Button>
              </a>
              <a href="#features">
                <Button
                  variant="outline"
                  size="lg"
                  className="h-16 border-4 border-black px-10 text-xl font-black shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] transition-all"
                >
                  LIHAT FITUR
                </Button>
              </a>
            </div>
          </div>

          <!-- Feature Illustration / Card -->
          <div
            class="hidden lg:block relative animate-in fade-in slide-in-from-right duration-1000"
          >
            <div
              class="absolute -inset-4 border-4 border-black dark:border-white/10 bg-orange-100 dark:bg-orange-900/10 -rotate-2"
            >
            </div>
            <div
              class="relative border-4 border-black dark:border-white/10 bg-white dark:bg-zinc-900 p-8 shadow-[12px_12px_0px_0px_rgba(0,0,0,1)] dark:shadow-[12px_12px_0px_0px_rgba(255,255,255,0.1)]"
            >
              <div class="space-y-4 font-mono">
                <div class="h-4 w-3/4 bg-black/10 dark:bg-white/10"></div>
                <div class="h-4 w-full bg-black/10 dark:bg-white/10"></div>
                <div
                  class="h-20 w-full border-4 border-black bg-green-100 dark:bg-green-900 p-4 font-bold text-sm"
                >
                  "AI sedang mengoptimalkan deskripsi kerja Anda..."
                </div>
                <div class="flex gap-2">
                  <div class="h-8 w-8 border-2 border-black bg-yellow-400">
                  </div>
                  <div class="h-8 w-8 border-2 border-black bg-blue-400"></div>
                  <div class="h-8 w-8 border-2 border-black bg-orange-400">
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Preview Section -->
  <section
    id="preview"
    class="py-24 bg-zinc-50 dark:bg-zinc-950 border-t-8 border-black overflow-hidden"
  >
    <div class="container">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="text-4xl font-black md:text-6xl uppercase tracking-tighter">
          Lihat AI Beraksi
        </h2>
        <p class="mt-4 text-xl font-bold text-orange-500">
          Transformasi instan dari biasa jadi luar biasa
        </p>
      </div>
      <InteractivePreview client:visible />
    </div>
  </section>

  <!-- Stats Section -->
  <section id="stats" class="border-y-8 border-black bg-orange-500 py-16">
    <div class="container">
      <div class="grid gap-8 md:grid-cols-3 text-white text-center">
        <div class="p-4">
          <div class="text-6xl font-black">100%</div>
          <div class="mt-2 text-xl font-bold uppercase tracking-widest">
            Gratis Selamanya
          </div>
        </div>
        <div class="p-4 border-y-4 md:border-y-0 md:border-x-4 border-black/20">
          <div class="text-6xl font-black">ATS</div>
          <div class="mt-2 text-xl font-bold uppercase tracking-widest">
            Score Optimizer
          </div>
        </div>
        <div class="p-4">
          <div class="text-6xl font-black">0</div>
          <div class="mt-2 text-xl font-bold uppercase tracking-widest">
            Data Terkirim ke Server
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section
    id="features"
    class="border-b-8 border-black bg-yellow-50 dark:bg-popover py-24"
  >
    <div class="container">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="text-4xl font-black md:text-6xl uppercase tracking-tighter">
          Kenapa Harus CuricuLab?
        </h2>
        <div class="mx-auto mt-4 h-4 w-48 bg-black"></div>
      </div>

      <div
        class="mt-16 grid text-secondary-foreground gap-10 md:grid-cols-2 lg:grid-cols-3"
      >
        <!-- Feature 1 -->
        <div
          class="border-4 border-black bg-white dark:text-white dark:bg-zinc-900 p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] transition-all hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]"
        >
          <div
            class="flex h-16 w-16 items-center justify-center border-4 border-black bg-orange-400 text-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"
              ></path></svg
            >
          </div>
          <h3 class="mt-6 text-2xl font-black uppercase">
            AI Gemini Optimization
          </h3>
          <p class="mt-4 text-lg font-medium">
            AI membantu menyempurnakan deskripsi kerja agar lebih profesional
            dan memikat sistem ATS secara otomatis.
          </p>
        </div>

        <!-- Feature 2 -->
        <div
          class="border-4 border-black bg-white dark:text-white dark:bg-zinc-900 p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] transition-all hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]"
        >
          <div
            class="flex h-16 w-16 items-center justify-center border-4 border-black bg-green-400 text-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"></path><path
                d="m9 12 2 2 4-4"></path></svg
            >
          </div>
          <h3 class="mt-6 text-2xl font-black uppercase">Privacy First</h3>
          <p class="mt-4 text-lg font-medium">
            100% data tersimpan di browser Anda. Tidak ada data pribadi yang
            dikirim atau disimpan di server kami.
          </p>
        </div>

        <!-- Feature 3 -->
        <div
          class="border-4 border-black bg-white dark:text-white dark:bg-zinc-900 p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] transition-all hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]"
        >
          <div
            class="flex h-16 w-16 items-center justify-center border-4 border-black bg-blue-400 text-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"
              ></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 9H8"
              ></path><path d="M16 13H8"></path><path d="M16 13H8"></path><path
                d="M16 17H8"></path></svg
            >
          </div>
          <h3 class="mt-6 text-2xl font-black uppercase">Template ATS Juara</h3>
          <p class="mt-4 text-lg font-medium">
            Didesain berdasarkan standar rekrutmen global untuk memastikan CV
            Anda terbaca sempurna oleh mesin scanning.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section
    id="how-it-works"
    class="py-24 border-b-8 border-black bg-white dark:bg-zinc-900"
  >
    <div class="container">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="text-4xl font-black md:text-6xl uppercase tracking-tighter">
          Cara Kerja
        </h2>
        <div class="mx-auto mt-4 h-4 w-32 bg-black dark:bg-white/20"></div>
      </div>

      <div class="mt-16 grid gap-8 md:grid-cols-3">
        <!-- Step 1 -->
        <div class="relative flex flex-col items-center text-center group">
          <div
            class="flex h-20 w-20 items-center justify-center border-4 border-black bg-primary text-3xl font-black text-white shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] group-hover:translate-x-[2px] group-hover:translate-y-[2px] group-hover:shadow-none transition-all"
          >
            1
          </div>
          <h3 class="mt-8 text-2xl font-black uppercase">ISI DATA</h3>
          <p class="mt-4 text-lg font-medium italic">
            "Masukkan pengalaman & keahlian terbaikmu."
          </p>
        </div>

        <!-- Step 2 -->
        <div class="relative flex flex-col items-center text-center group">
          <div
            class="flex h-20 w-20 items-center justify-center border-4 border-black bg-yellow-400 text-3xl font-black text-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] group-hover:translate-x-[2px] group-hover:translate-y-[2px] group-hover:shadow-none transition-all"
          >
            2
          </div>
          <h3 class="mt-8 text-2xl font-black uppercase">OPTIMASI AI</h3>
          <p class="mt-4 text-lg font-medium italic">
            "Biarkan AI Gemini memoles CV-mu jadi pro."
          </p>
        </div>

        <!-- Step 3 -->
        <div class="relative flex flex-col items-center text-center group">
          <div
            class="flex h-20 w-20 items-center justify-center border-4 border-black bg-blue-400 text-3xl font-black text-white shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] group-hover:translate-x-[2px] group-hover:translate-y-[2px] group-hover:shadow-none transition-all"
          >
            3
          </div>
          <h3 class="mt-8 text-2xl font-black uppercase">EXPORT & LAMAR</h3>
          <p class="mt-4 text-lg font-medium italic">
            "Download PDF/DOCX dan raih impianmu."
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Templates Section -->
  <section
    id="templates"
    class="py-24 bg-pink-50 dark:bg-zinc-950 border-b-8 border-black"
  >
    <div class="container">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="text-4xl font-black md:text-6xl uppercase tracking-tighter">
          Template Juara
        </h2>
        <p class="mt-4 text-xl font-bold">
          Teruji & Dipercaya oleh Sistem ATS Global
        </p>
      </div>

      <div class="grid gap-12 md:grid-cols-2 max-w-4xl mx-auto">
        <div class="group cursor-pointer">
          <div
            class="aspect-3/4 border-8 border-black dark:border-white/10 bg-white dark:bg-zinc-900 shadow-[12px_12px_0px_0px_rgba(0,0,0,1)] dark:shadow-[12px_12px_0px_10px_rgba(255,255,255,0.05)] transition-all group-hover:translate-x-[4px] group-hover:translate-y-[4px] group-hover:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] dark:group-hover:shadow-[8px_8px_0px_0px_rgba(255,255,255,0.05)] overflow-hidden p-6 relative"
          >
            <div
              class="absolute inset-0 bg-black/10 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity z-10"
            >
              <span
                class="bg-black text-white px-6 py-3 font-black text-xl border-4 border-white shadow-[8px_8px_0px_0px_rgba(0,0,0,1)]"
                >LIHAT DETAIL</span
              >
            </div>
            <div class="space-y-3 opacity-20">
              <div class="h-4 w-1/3 bg-black"></div>
              <div class="h-8 w-full bg-black"></div>
              <div class="h-4 w-2/3 bg-black"></div>
              <div class="space-y-1">
                <div class="h-2 w-full bg-black/40 dark:bg-white/40"></div>
                <div class="h-2 w-full bg-black/40 dark:bg-white/40"></div>
                <div class="h-2 w-3/4 bg-black/40 dark:bg-white/40"></div>
              </div>
            </div>
          </div>
          <h3 class="mt-8 text-2xl font-black text-center uppercase">
            CREATIVE ATS 01
          </h3>
        </div>

        <div class="group cursor-pointer">
          <div
            class="aspect-3/4 border-8 border-black dark:border-white/10 bg-white dark:bg-zinc-900 shadow-[12px_12px_0px_0px_rgba(0,0,0,1)] dark:shadow-[12px_12px_0px_10px_rgba(255,255,255,0.05)] transition-all group-hover:translate-x-[4px] group-hover:translate-y-[4px] group-hover:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] dark:group-hover:shadow-[8px_8px_0px_0px_rgba(255,255,255,0.05)] overflow-hidden p-6 relative"
          >
            <div
              class="absolute inset-0 bg-black/10 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity z-10"
            >
              <span
                class="bg-black text-white px-6 py-3 font-black text-xl border-4 border-white shadow-[8px_8px_0px_0px_rgba(0,0,0,1)]"
                >LIHAT DETAIL</span
              >
            </div>
            <div class="space-y-4 opacity-20">
              <div class="flex justify-between">
                <div class="h-10 w-1/2 bg-black"></div>
                <div class="h-10 w-10 bg-black"></div>
              </div>
              <div class="h-2 w-full bg-black"></div>
              <div class="grid grid-cols-2 gap-4">
                <div class="space-y-2">
                  <div class="h-2 w-full bg-black/40"></div>
                  <div class="h-2 w-full bg-black/40"></div>
                </div>
                <div class="space-y-2">
                  <div class="h-2 w-full bg-black/40"></div>
                  <div class="h-2 w-full bg-black/40"></div>
                </div>
              </div>
            </div>
          </div>
          <h3 class="mt-8 text-2xl font-black text-center uppercase">
            CREATIVE ATS 02
          </h3>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section
    id="testimonials"
    class="py-24 bg-blue-50 dark:bg-zinc-950 border-b-8 border-black"
  >
    <div class="container">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="text-4xl font-black md:text-6xl uppercase tracking-tighter">
          Apa Kata Mereka?
        </h2>
        <div class="mx-auto mt-4 h-4 w-48 bg-black"></div>
      </div>

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        <div
          class="border-4 border-black bg-white dark:bg-zinc-900 p-6 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)]"
        >
          <p class="text-lg font-bold italic">
            "Gila sih, CV gw yang tadinya berantakan jadi rapi banget. Langsung
            dapet panggila interview minggu depannya!"
          </p>
          <div class="mt-4 flex items-center gap-3">
            <div class="h-10 w-10 border-2 border-black bg-yellow-400"></div>
            <div>
              <p class="font-black uppercase">Andi Pratama</p>
              <p class="text-xs font-bold text-zinc-500">Frontend Developer</p>
            </div>
          </div>
        </div>
        <div
          class="border-4 border-black bg-white dark:bg-zinc-900 p-6 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)]"
        >
          <p class="text-lg font-bold italic">
            "Paling suka bagian AI-nya. Deskripsi kerja gw dipoles jadi
            bener-bener pro. Masih ga percaya ini gratis."
          </p>
          <div class="mt-4 flex items-center gap-3">
            <div class="h-10 w-10 border-2 border-black bg-green-400"></div>
            <div>
              <p class="font-black uppercase">Siti Aminah</p>
              <p class="text-xs font-bold text-zinc-500">Digital Marketer</p>
            </div>
          </div>
        </div>
        <div
          class="border-4 border-black bg-white dark:bg-zinc-900 p-6 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)]"
        >
          <p class="text-lg font-bold italic">
            "Akhirnya ada builder yang ga ribet suruh login atau bayar di akhir.
            Hasil PDF-nya juga clean dan ATS-friendly."
          </p>
          <div class="mt-4 flex items-center gap-3">
            <div class="h-10 w-10 border-2 border-black bg-blue-400"></div>
            <div>
              <p class="font-black uppercase">Budi Santoso</p>
              <p class="text-xs font-bold text-zinc-500">Fresh Graduate</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section
    id="faq"
    class="py-24 bg-white dark:bg-zinc-900 border-b-8 border-black"
  >
    <div class="container max-w-4xl">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-black md:text-6xl uppercase tracking-tighter">
          FAQ
        </h2>
        <div class="mx-auto mt-4 h-4 w-16 bg-black dark:bg-white/20"></div>
      </div>

      <div class="space-y-6">
        <div
          class="border-4 border-black p-6 group cursor-pointer hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors"
        >
          <h3
            class="text-xl font-black uppercase flex justify-between items-center italic"
          >
            Apakah ini benar-benar gratis?
            <span class="text-2xl">+</span>
          </h3>
          <p class="mt-4 font-medium hidden group-hover:block">
            Ya, 100% gratis. Tidak ada biaya tersembunyi, tidak ada fitur yang
            dikunci di balik sistem langganan.
          </p>
        </div>
        <div
          class="border-4 border-black p-6 group cursor-pointer hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors"
        >
          <h3
            class="text-xl font-black uppercase flex justify-between items-center italic"
          >
            Apakah data saya aman?
            <span class="text-2xl">+</span>
          </h3>
          <p class="mt-4 font-medium hidden group-hover:block">
            Sangat aman. Semua data Anda disimpan secara lokal di browser Anda.
            Kami tidak menyimpan data pribadi Anda di server kami.
          </p>
        </div>
        <div
          class="border-4 border-black p-6 group cursor-pointer hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors"
        >
          <h3
            class="text-xl font-black uppercase flex justify-between items-center italic"
          >
            Berapa banyak CV yang bisa saya buat?
            <span class="text-2xl">+</span>
          </h3>
          <p class="mt-4 font-medium hidden group-hover:block">
            Sebanyak yang Anda mau. Tidak ada batasan jumlah CV yang bisa Anda
            buat dan download.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-32 bg-yellow-400 dark:bg-primary overflow-hidden relative">
    <div
