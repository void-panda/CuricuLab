---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Button } from "@/components/ui/button";
---

<BaseLayout
  title="CuricuLab - AI-Powered CV Builder"
  description="Buat CV profesional dan ATS-friendly dengan bantuan AI. 100% gratis, tanpa login, data tersimpan di browser Anda."
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-background">
    <!-- Decorative Elements (Neobrutalism Style) -->
    <div
      class="absolute top-10 right-10 -rotate-12 border-4 border-black bg-yellow-400 p-4 font-mono font-bold shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] hidden lg:block"
    >
      100% GRATIS!
    </div>
    <div
      class="absolute bottom-20 left-10 rotate-6 border-4 border-black bg-blue-400 p-3 font-mono font-bold shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] hidden lg:block"
    >
      NO LOGIN REQUIRED
    </div>

    <div class="container py-24 md:py-32">
      <div class="mx-auto max-w-4xl">
        <div class="grid gap-12 lg:grid-cols-[1fr_400px]">
          <div class="text-left">
            <!-- Badge -->
            <div
              class="mb-8 inline-flex items-center gap-2 border-4 border-black bg-green-400 px-6 py-2 font-mono text-sm font-bold shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
            >
              <span class="relative flex h-3 w-3">
                <span
                  class="absolute inline-flex h-full w-full animate-ping rounded-full bg-black opacity-20"
                ></span>
                <span class="relative inline-flex h-3 w-3 rounded-full bg-black"
                ></span>
              </span>
              CURICULAB v1.0
            </div>

            <!-- Headline -->
            <h1
              class="text-5xl font-black tracking-tighter md:text-7xl lg:text-8xl"
            >
              BUAT CV <br />
              <span
                class="bg-orange-500 px-4 py-2 text-white border-4 border-black shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] inline-block my-2"
              >
                SUPER ATS
              </span>
              <br />
              DENGAN AI.
            </h1>

            <!-- Subheadline -->
            <p
              class="mt-8 text-xl font-medium leading-relaxed md:text-2xl max-w-2xl border-l-8 border-black pl-6"
            >
              Hentikan penolakan kerja karena CV tidak terbaca sistem.
              <strong>CuricuLab</strong> menggunakan AI Gemini untuk memastikan CV
              Anda lolos ATS & memikat rekruter.
            </p>

            <!-- CTA Buttons -->
            <div class="mt-12 flex flex-col gap-6 sm:flex-row">
              <a href="/builder">
                <Button
                  size="lg"
                  className="h-16 border-4 border-black px-10 text-xl font-black shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] transition-all bg-primary text-white"
                >
                  MULAI SEKARANG →
                </Button>
              </a>
              <a href="#features">
                <Button
                  variant="outline"
                  size="lg"
                  className="h-16 border-4 border-black px-10 text-xl font-black shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] transition-all"
                >
                  LIHAT FITUR
                </Button>
              </a>
            </div>
          </div>

          <!-- Feature Illustration / Card -->
          <div class="hidden lg:block relative">
            <div
              class="absolute -inset-4 border-4 border-black bg-orange-100 -rotate-2"
            >
            </div>
            <div
              class="relative border-4 border-black bg-white p-8 shadow-[12px_12px_0px_0px_rgba(0,0,0,1)]"
            >
              <div class="space-y-4 font-mono">
                <div class="h-4 w-3/4 bg-black/10"></div>
                <div class="h-4 w-full bg-black/10"></div>
                <div
                  class="h-20 w-full border-4 border-black bg-green-100 p-4 font-bold text-sm"
                >
                  "AI sedang mengoptimalkan deskripsi kerja Anda..."
                </div>
                <div class="flex gap-2">
                  <div class="h-8 w-8 border-2 border-black bg-yellow-400">
                  </div>
                  <div class="h-8 w-8 border-2 border-black bg-blue-400"></div>
                  <div class="h-8 w-8 border-2 border-black bg-orange-400">
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section
    id="features"
    class="border-y-8 border-black bg-yellow-50 dark:bg-primary py-24"
  >
    <div class="container">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="text-4xl font-black md:text-6xl uppercase tracking-tighter">
          Kenapa Harus CuricuLab?
        </h2>
        <div class="mx-auto mt-4 h-4 w-48 bg-black"></div>
      </div>

      <div
        class="mt-16 grid text-secondary-foreground gap-10 md:grid-cols-2 lg:grid-cols-3"
      >
        <!-- Feature 1 -->
        <div
          class="border-4 border-black bg-white p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] transition-all hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]"
        >
          <div
            class="flex h-16 w-16 items-center justify-center border-4 border-black bg-orange-400 text-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"
              ></path></svg
            >
          </div>
          <h3 class="mt-6 text-2xl font-black uppercase">
            AI Gemini Optimization
          </h3>
          <p class="mt-4 text-lg font-medium">
            AI membantu menyempurnakan deskripsi kerja agar lebih profesional
            dan memikat sistem ATS secara otomatis.
          </p>
        </div>

        <!-- Feature 2 -->
        <div
          class="border-4 border-black bg-white p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] transition-all hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]"
        >
          <div
            class="flex h-16 w-16 items-center justify-center border-4 border-black bg-green-400 text-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"></path><path
                d="m9 12 2 2 4-4"></path></svg
            >
          </div>
          <h3 class="mt-6 text-2xl font-black uppercase">Privacy First</h3>
          <p class="mt-4 text-lg font-medium">
            100% data tersimpan di browser Anda. Tidak ada data pribadi yang
            dikirim atau disimpan di server kami.
          </p>
        </div>

        <!-- Feature 3 -->
        <div
          class="border-4 border-black bg-white p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] transition-all hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]"
        >
          <div
            class="flex h-16 w-16 items-center justify-center border-4 border-black bg-blue-400 text-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"
              ></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 9H8"
              ></path><path d="M16 13H8"></path><path d="M16 13H8"></path><path
                d="M16 17H8"></path></svg
            >
          </div>
          <h3 class="mt-6 text-2xl font-black uppercase">Template ATS Juara</h3>
          <p class="mt-4 text-lg font-medium">
            Didesain berdasarkan standar rekrutmen global untuk memastikan CV
            Anda terbaca sempurna oleh mesin scanning.
          </p>
        </div>

        <!-- Feature 4 -->
        <div
          class="border-4 border-black bg-white p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] transition-all hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]"
        >
          <div
            class="flex h-16 w-16 items-center justify-center border-4 border-black bg-purple-400 text-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
              ></path><polyline points="7 10 12 15 17 10"></polyline><line
                x1="12"
                x2="12"
                y1="15"
                y2="3"></line></svg
            >
          </div>
          <h3 class="mt-6 text-2xl font-black uppercase">Export PDF & DOCX</h3>
          <p class="mt-4 text-lg font-medium">
            Download hasil kreasi Anda dalam format PDF atau DOCX yang rapi dan
            siap kirim ke HRD.
          </p>
        </div>

        <!-- Feature 5 -->
        <div
          class="border-4 border-black bg-white p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] transition-all hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]"
        >
          <div
            class="flex h-16 w-16 items-center justify-center border-4 border-black bg-red-400 text-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg
            >
          </div>
          <h3 class="mt-6 text-2xl font-black uppercase">Dark Mode Support</h3>
          <p class="mt-4 text-lg font-medium">
            Nyaman digunakan kapan saja. Mendukung tema gelap yang tetap kontras
            dan berkarakter.
          </p>
        </div>

        <!-- Feature 6 -->
        <div
          class="border-4 border-black bg-white p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] transition-all hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]"
        >
          <div
            class="flex h-16 w-16 items-center justify-center border-4 border-black bg-pink-400 text-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"
              ></path></svg
            >
          </div>
          <h3 class="mt-6 text-2xl font-black uppercase">Free Forever</h3>
          <p class="mt-4 text-lg font-medium">
            Tanpa biaya langganan, tanpa iklan, dan tanpa watermark. Murni untuk
            membantu karir Anda.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section class="py-24 border-b-8 border-black">
    <div class="container">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="text-4xl font-black md:text-6xl uppercase tracking-tighter">
          Cara Kerja
        </h2>
        <div class="mx-auto mt-4 h-4 w-32 bg-black"></div>
      </div>

      <div class="mt-16 grid gap-8 md:grid-cols-3">
        <!-- Step 1 -->
        <div class="relative flex flex-col items-center text-center">
          <div
            class="flex h-20 w-20 items-center justify-center border-4 border-black bg-primary text-3xl font-black text-white shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]"
          >
            1
          </div>
          <h3 class="mt-8 text-2xl font-black uppercase">ISI DATA</h3>
          <p class="mt-4 text-lg font-medium italic">
            "Masukkan pengalaman & keahlian terbaikmu."
          </p>
        </div>

        <!-- Step 2 -->
        <div class="relative flex flex-col items-center text-center">
          <div
            class="flex h-20 w-20 items-center justify-center border-4 border-black bg-yellow-400 text-3xl font-black text-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]"
          >
            2
          </div>
          <h3 class="mt-8 text-2xl font-black uppercase">OPTIMASI AI</h3>
          <p class="mt-4 text-lg font-medium italic">
            "Biarkan AI Gemini memoles CV-mu jadi pro."
          </p>
        </div>

        <!-- Step 3 -->
        <div class="relative flex flex-col items-center text-center">
          <div
            class="flex h-20 w-20 items-center justify-center border-4 border-black bg-blue-400 text-3xl font-black text-white shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]"
          >
            3
          </div>
          <h3 class="mt-8 text-2xl font-black uppercase">EXPORT & LAMAR</h3>
          <p class="mt-4 text-lg font-medium italic">
            "Download PDF/DOCX dan raih impianmu."
          </p>
        </div>
      </div>

      <div class="mt-20 text-center">
        <a href="/builder">
          <Button
            size="lg"
            className="h-16 border-4 border-black px-12 text-2xl font-black shadow-[10px_10px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] transition-all bg-green-400 text-black uppercase"
          >
            MULAI SEKARANG!
          </Button>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
